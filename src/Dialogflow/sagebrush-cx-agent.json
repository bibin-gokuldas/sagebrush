      "displayName": "sagebrush-webhook",
      "genericWebService": {
        "uri": "https://bibingokuldas.service-now.com/api/x_sagebrush/dialogflow_webhook",
        "requestHeaders": {
          "Content-Type": "application/json",
          "X-Webhook-Secret": "<SET_FROM_x_sagebrush.dialogflow.webhook_secret_PROPERTY>"
        },
        "httpMethod": "POST"
      },
      "timeout": "30s"
    }
  ]
}
