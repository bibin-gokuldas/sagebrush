{
  "name": "SAGEBRUSH_DQFullScan",
  "label": "SAGEBRUSH — Full DQ Scan",
  "description": "Runs a full DQ scan across all domains. Scheduled weekly or triggered on demand.",
  "trigger": { "type": "scheduled", "schedule": "0 2 * * 0" },
  "steps": [
    {
      "name": "Start DQ Run",
      "type": "script_action",
      "script": "var engine = new SAGEBRUSHDQEngine(); var runId = engine.startRun(null, 'all'); fd_data.run_sys_id = runId;",
      "on_error": "stop_and_log"
    }
  ]
}