{
  "name": "SAGEBRUSH_DesignGeneration",
  "label": "SAGEBRUSH Solution Design Generation",
  "description": "End-to-end orchestration: extract requirements, scan instance, map to OOB, generate HLD and LLD",
  "trigger": {
    "type": "record_created_or_updated",
    "table": "x_sagebrush_session",
    "condition": "intent=solution_design AND state=active"
  },
  "inputs": [
    { "name": "session_sys_id", "type": "string", "label": "Session Sys ID" }
  ],
  "steps": [
    {
      "name": "Scan Instance",
      "type": "action",
      "action": "x_sagebrush.SAGEBRUSHInstanceScanner_scan",
      "inputs": { "session_id": "{{trigger.current.sys_id}}" },
      "outputs": { "snapshot_sys_id": "snapshotId" },
      "on_error": "log_and_continue"
    },
    {
      "name": "Map Requirements to OOB",
      "type": "action",
      "action": "x_sagebrush.SAGEBRUSHOOBMapper_mapSession",
      "inputs": { "session_id": "{{trigger.current.sys_id}}", "snapshot_sys_id": "{{snapshotId}}" },
      "outputs": { "mapping_count": "mappingCount" },
      "on_error": "log_and_continue"
    },
    {
      "name": "Generate HLD",
      "type": "action",
      "action": "x_sagebrush.SAGEBRUSHDesignWriter_generateHLD",
      "inputs": { "session_id": "{{trigger.current.sys_id}}" },
      "outputs": { "hld_sys_id": "hldId" },
      "on_error": "stop_and_notify"
    },
    {
      "name": "Generate LLD",
      "type": "action",
      "action": "x_sagebrush.SAGEBRUSHDesignWriter_generateLLD",
      "inputs": { "session_id": "{{trigger.current.sys_id}}", "hld_sys_id": "{{hldId}}" },
      "outputs": { "lld_sys_id": "lldId" },
      "on_error": "stop_and_notify"
    }
  ]
}
