{
  "name": "x_snc_sagebrush_oob_capability",
  "label": "SAGEBRUSH OOB Capability",
  "extends": "",
  "fields": [
    { "name": "capability_name",  "type": "string",  "label": "Capability Name",    "mandatory": true },
    { "name": "module",           "type": "string",  "label": "ServiceNow Module",  "mandatory": true },
    { "name": "description",      "type": "string",  "max_length": 2048, "label": "Description" },
    { "name": "priority_level",   "type": "integer", "label": "Priority Level (1-5)", "mandatory": true },
    { "name": "plugin_id",        "type": "string",  "label": "Required Plugin ID" },
    { "name": "license_tier",     "type": "choice",  "choices": ["standard","pro","enterprise","store","free"], "label": "License Tier" },
    { "name": "tables_involved",  "type": "string",  "max_length": 1024, "label": "Tables (comma-separated)" },
    { "name": "keywords",         "type": "string",  "max_length": 2048, "label": "Matching Keywords (comma-separated)" },
    { "name": "domain",           "type": "choice",  "choices": ["itsm","itom","grc","bcm","csm","hrsd","platform","custom"], "label": "Domain" },
    { "name": "active",           "type": "boolean", "label": "Active", "default": true }
  ]
}
