{
  "name": "x_sagebrush_dq_run",
  "label": "SAGEBRUSH DQ Run",
  "extends": "",
  "fields": [
    { "name": "run_type",       "type": "choice",  "choices": ["full","domain","targeted"], "label": "Run Type", "mandatory": true },
    { "name": "domain",         "type": "string",  "label": "Domain (if domain run)" },
    { "name": "target_table",   "type": "string",  "label": "Table (if targeted run)" },
    { "name": "triggered_by",   "type": "choice",  "choices": ["scheduled","conversation","manual"], "label": "Triggered By" },
    { "name": "session",        "type": "reference","ref_table": "x_sagebrush_session", "label": "SAGEBRUSH Session" },
    { "name": "state",          "type": "choice",  "choices": ["running","complete","failed"], "label": "State", "default": "running" },
    { "name": "checks_run",     "type": "integer", "label": "Checks Run" },
    { "name": "issues_found",   "type": "integer", "label": "Issues Found" },
    { "name": "critical_count", "type": "integer", "label": "Critical Issues" },
    { "name": "high_count",     "type": "integer", "label": "High Issues" },
    { "name": "medium_count",   "type": "integer", "label": "Medium Issues" },
    { "name": "low_count",      "type": "integer", "label": "Low Issues" },
    { "name": "duration_ms",    "type": "integer", "label": "Duration (ms)" },
    { "name": "dq_score",       "type": "decimal", "label": "DQ Score (0-100)" }
  ]
}
