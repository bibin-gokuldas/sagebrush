{
  "name": "x_snc_sagebrush_requirement",
  "label": "SAGEBRUSH Requirement",
  "extends": "",
  "fields": [
    { "name": "session",           "type": "reference", "ref_table": "x_snc_sagebrush_session", "label": "Session",          "mandatory": true },
    { "name": "requirement_text",  "type": "string",    "max_length": 4096,                  "label": "Requirement Text", "mandatory": true },
    { "name": "requirement_type",  "type": "choice",    "choices": ["functional","non_functional","integration","constraint"], "label": "Type" },
    { "name": "priority",          "type": "choice",    "choices": ["high","medium","low"],  "label": "Priority", "default": "medium" },
    { "name": "source",            "type": "choice",    "choices": ["voice","chat","document"], "label": "Source" },
    { "name": "confirmed",         "type": "boolean",   "label": "User Confirmed", "default": false },
    { "name": "oob_mapping",       "type": "reference", "ref_table": "x_snc_sagebrush_oob_map", "label": "OOB Mapping" },
    { "name": "sequence",          "type": "integer",   "label": "Sequence Number" }
  ]
}
