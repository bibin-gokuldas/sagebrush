{
  "name": "SAGEBRUSH_DQScore_ByDomain",
  "label": "SAGEBRUSH — DQ Score by Domain",
  "description": "Data Quality score broken down by ServiceNow domain",
  "source_table": "x_snc_sagebrush_dq_run",
  "aggregation": "AVG",
  "field": "dq_score",
  "breakdown_by": "domain",
  "filter": "state=complete^sys_created_onONLast 7 days@javascript:gs.beginningOfLast7Days()@javascript:gs.endOfLast7Days()",
  "frequency": "daily",
  "target": 85,
  "direction": "maximize"
}